{
  "name": "short-url",
  "version": "1.0.0",
  "description": "Cloudflare Worker short URL service with D1, admin panel, and MCP support",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 execute short-url-db --local --file=./migrations/0001_init.sql",
    "d1:migrate:remote": "wrangler d1 execute short-url-db --file=./migrations/0001_init.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.114.17"
  }
}
